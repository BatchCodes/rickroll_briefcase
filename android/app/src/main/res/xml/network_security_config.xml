<?xml version="1.0" encoding="utf-8"?>
<!-- The briefcase web app uses plain HTTP on its own Wi-Fi network.
     Allow clear text only for the briefcase addresses. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">briefcase.lan</domain>
        <domain includeSubdomains="false">10.42.0.1</domain>
    </domain-config>
</network-security-config>
